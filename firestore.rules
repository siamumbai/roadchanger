rules_version = '2';

// roadchanger.com/kalendars/ — drošības noteikumi.
// Lietotāji glabājas users/{e-pasts mazajiem burtiem}: view = kalendāri, ko redz; edit = kuros raksta.
// Pasākums ar vairākiem kalendāriem glabājas kā kopija katra kalendāra mapē ar vienu un to pašu ID.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && myEmail() == 'e.asmanis@gmail.com';
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(myEmail())).data;
    }
    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(myEmail()));
    }
    function canView(cal) {
      return isAdmin() || (signedIn() && hasProfile() && cal in me().get('view', []));
    }
    function canEdit(cal) {
      return isAdmin() || (signedIn() && hasProfile() && cal in me().get('edit', []));
    }

    function validEvent(cal) {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'dateEnd', 'cals', 'status', 'from', 'to', 'dur', 'title', 'place', 'address', 'notes',
                               'createdBy', 'createdAt', 'updatedBy', 'updatedAt',
                               'deleted', 'deletedAt', 'deletedBy'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('dateEnd' in d) || d.dateEnd == '' || (d.dateEnd is string && d.dateEnd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.dateEnd >= d.date))
        && d.cals is list && cal in d.cals && d.cals.size() <= 30
        && d.status in ['interese', 'rezervets', 'apstiprinats', 'meg_interese', 'meg_apstiprinats']
        && d.from is string && d.from.size() <= 5
        && d.to is string && d.to.size() <= 5
        && d.place is string && d.place.size() <= 300
        && (!('title' in d) || (d.title is string && d.title.size() <= 300))
        && (!('dur' in d) || (d.dur is string && d.dur.size() <= 5))
        && (!('address' in d) || (d.address is string && d.address.size() <= 300))
        && d.notes is string && d.notes.size() <= 5000
        && d.deleted is bool
        && d.updatedBy == myEmail();
    }

    match /users/{email} {
      allow read: if isAdmin() || (signedIn() && myEmail() == email);
      // Pirmā pieteikšanās: drīkst izveidot tikai savu ierakstu, bez piekļuvēm.
      allow create: if isAdmin()
        || (signedIn() && myEmail() == email
            && request.resource.data.keys().hasOnly(['email', 'createdAt', 'lastSeen'])
            && request.resource.data.email == email);
      // Pats drīkst mainīt tikai "pēdējo reizi redzēts".
      allow update: if isAdmin()
        || (signedIn() && myEmail() == email
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen']));
      allow delete: if isAdmin();
    }

    match /calendars/{cal} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /events/{eid} {
        allow read: if canView(cal);
        allow create: if canEdit(cal) && validEvent(cal)
          && request.resource.data.createdBy is string;
        allow update: if canEdit(cal) && validEvent(cal)
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if canEdit(cal);
      }
    }

    // Personīgais "Aizņemts": katram e-pastam savs. Vienas dienas dokuments, ID = datums.
    // Lasa un maina tikai pats; admins var lasīt (skats "kā šis e-pasts redz").
    match /busy/{email}/days/{day} {
      // Lasa arī tie, kuriem admins atļāvis redzēt šī e-pasta aizņemtos datumus (users/{lasītājs}.seeBusy)
      allow read: if isAdmin() || (signedIn() && myEmail() == email)
        || (signedIn() && hasProfile() && email in me().get('seeBusy', []));
      allow create: if signedIn() && myEmail() == email
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['date', 'at'])
        && request.resource.data.date == day;
      allow delete: if signedIn() && myEmail() == email;
    }

    // ================= roadchanger.com/scenarijs/ =================
    // Pieteikšanās ar paroli (anonīms Firebase lietotājs). Admin parole šeit ir tikai kā
    // SHA-256 (repo ir publisks). Projekta paroles glabājas scenarios/{sid}/keys/main —
    // to lasa tikai admins; noteikumu get() to redz arī bez lasīšanas tiesībām.
    function anyUser() {
      return request.auth != null;
    }
    function scnAdmin() {
      return isAdmin() || (anyUser()
        && exists(/databases/$(database)/documents/scnAdmins/$(request.auth.uid)));
    }
    function scnMe(sid) {
      return get(/databases/$(database)/documents/scenarios/$(sid)/members/$(request.auth.uid)).data;
    }
    function scnMember(sid) {
      return anyUser()
        && exists(/databases/$(database)/documents/scenarios/$(sid)/members/$(request.auth.uid));
    }
    function scnWriter(sid) {
      return scnAdmin() || (scnMember(sid) && scnMe(sid).role == 'rw');
    }

    match /scnAdmins/{uid} {
      allow read: if anyUser() && request.auth.uid == uid;
      allow create: if anyUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pw', 'at'])
        && request.resource.data.pw is string
        && hashing.sha256(request.resource.data.pw).toHexString().lower()
           == '2cceff1b340a228b9ab9d09a3eda94cea5e4810336158636e7dd0768cba302ea';
      allow delete: if anyUser() && request.auth.uid == uid;
    }

    // Paroles rādītājs: dokumenta ID = sha256('scn:' + parole). Tikai get, ne list —
    // bez paroles nevar uzzināt, kādi projekti eksistē. Update nav: parole ir unikāla.
    // Projektam vēsturē rādītāji ir izdzēsti — paroles nestrādā.
    // Lomas: rw = lasīt/rakstīt, ro = tikai lasīt, cat = lasīt + rakstīt tikai savas kategorijas rindas.
    match /scnIndex/{h} {
      allow get: if anyUser();
      allow list: if scnAdmin();
      allow create: if scnAdmin()
        && request.resource.data.keys().hasOnly(['sid', 'role', 'cat'])
        && request.resource.data.role in ['rw', 'ro', 'cat'];
      allow delete: if scnAdmin();
    }

    match /scenarios/{sid} {
      allow read: if scnAdmin() || scnMember(sid);
      allow create, delete: if scnAdmin();
      // Valodu un vēsturi maina tikai admins.
      allow update: if scnAdmin()
        || (scnWriter(sid)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lang', 'createdAt', 'archived', 'archivedAt']));

      // keys/main: { rw, ro, cats: { <kategorijas id>: parole } }
      match /keys/{k} {
        allow read, write: if scnAdmin();
      }

      match /members/{uid} {
        allow read: if scnAdmin() || (anyUser() && request.auth.uid == uid);
        allow create: if anyUser() && request.auth.uid == uid
          && get(/databases/$(database)/documents/scenarios/$(sid)).data.get('archived', false) == false
          && request.resource.data.keys().hasOnly(['pw', 'role', 'cat', 'at'])
          && (
            (request.resource.data.role in ['rw', 'ro']
              && request.resource.data.pw
                 == get(/databases/$(database)/documents/scenarios/$(sid)/keys/main).data[request.resource.data.role])
            || (request.resource.data.role == 'cat' && request.resource.data.cat is string
              && request.resource.data.pw
                 == get(/databases/$(database)/documents/scenarios/$(sid)/keys/main).data.cats[request.resource.data.cat])
          );
        allow delete: if scnAdmin() || (anyUser() && request.auth.uid == uid);
      }

      match /rows/{rid} {
        allow read: if scnAdmin() || scnMember(sid);
        allow create, delete: if scnWriter(sid);
        // Kategorijas parole: drīkst labot rindas, kas ir (un paliek) atzīmētas ar savu kategoriju,
        // un jebkurā rindā — tikai savas kategorijas komentāru (catNotes.<kategorija>).
        allow update: if scnWriter(sid)
          || (scnMember(sid) && scnMe(sid).role == 'cat'
              && ((scnMe(sid).cat in resource.data.get('cats', [])
                   && scnMe(sid).cat in request.resource.data.get('cats', []))
                  || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['catNotes'])
                      && request.resource.data.catNotes.diff(resource.data.get('catNotes', {}))
                           .affectedKeys().hasOnly([scnMe(sid).cat]))));
      }

      // Kategorijas ierašanās laiks + komentārs: catinfo/{kategorija} = { arrive, note }.
      match /catinfo/{cat} {
        allow read: if scnAdmin() || scnMember(sid);
        allow write: if scnWriter(sid)
          || (scnMember(sid) && scnMe(sid).role == 'cat' && scnMe(sid).cat == cat
              && request.resource.data.keys().hasOnly(['arrive', 'note']));
      }
    }
  }
}
