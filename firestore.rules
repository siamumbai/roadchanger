rules_version = '2';

// roadchanger.com/kalendars/ — drošības noteikumi.
// Lietotāji glabājas users/{e-pasts mazajiem burtiem}: view = kalendāri, ko redz; edit = kuros raksta.
// Pasākums ar vairākiem kalendāriem glabājas kā kopija katra kalendāra mapē ar vienu un to pašu ID.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && myEmail() == 'e.asmanis@gmail.com';
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(myEmail())).data;
    }
    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(myEmail()));
    }
    function canView(cal) {
      return isAdmin() || (signedIn() && hasProfile() && cal in me().get('view', []));
    }
    function canEdit(cal) {
      return isAdmin() || (signedIn() && hasProfile() && cal in me().get('edit', []));
    }

    function validEvent(cal) {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'cals', 'status', 'from', 'to', 'place', 'notes',
                               'createdBy', 'createdAt', 'updatedBy', 'updatedAt',
                               'deleted', 'deletedAt', 'deletedBy'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.cals is list && cal in d.cals && d.cals.size() <= 30
        && d.status in ['interese', 'rezervets', 'apstiprinats']
        && d.from is string && d.from.size() <= 5
        && d.to is string && d.to.size() <= 5
        && d.place is string && d.place.size() <= 300
        && d.notes is string && d.notes.size() <= 5000
        && d.deleted is bool
        && d.updatedBy == myEmail();
    }

    match /users/{email} {
      allow read: if isAdmin() || (signedIn() && myEmail() == email);
      // Pirmā pieteikšanās: drīkst izveidot tikai savu ierakstu, bez piekļuvēm.
      allow create: if isAdmin()
        || (signedIn() && myEmail() == email
            && request.resource.data.keys().hasOnly(['email', 'createdAt', 'lastSeen'])
            && request.resource.data.email == email);
      // Pats drīkst mainīt tikai "pēdējo reizi redzēts".
      allow update: if isAdmin()
        || (signedIn() && myEmail() == email
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen']));
      allow delete: if isAdmin();
    }

    match /calendars/{cal} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /events/{eid} {
        allow read: if canView(cal);
        allow create: if canEdit(cal) && validEvent(cal)
          && request.resource.data.createdBy is string;
        allow update: if canEdit(cal) && validEvent(cal)
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if canEdit(cal);
      }
    }
  }
}
